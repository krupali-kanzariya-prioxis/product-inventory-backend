using ProductInventoryTrackerAPI.Common;
using ProductInventoryTrackerAPI.Model.CommonModel;
using ProductInventoryTrackerAPI.Model.ProductInventoryDB;
using ProductInventoryTrackerAPI.Model.RequestModel;
using ProductInventoryTrackerAPI.Model.ResponseModel;
using ProductInventoryTrackerAPI.Service.Repository.Interfaces;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;
using static ProductInventoryTrackerAPI.Common.Enums;

namespace ProductInventoryTrackerAPI.Service.Repository.Implementation
{
    public class SupplierRepository : ISupplierRepository
    {
        private readonly ProductInventoryDBContext _context;
        private readonly ILogger<SupplierRepository> _logger;

        public SupplierRepository(ProductInventoryDBContext context, ILogger<SupplierRepository> logger)
        {
            _context = context;
            _logger = logger;
        }

        public async Task<Page> GetSuppliersAsync(Dictionary<string, object> parameters)
        {
            try
            {
                var pageStart = Convert.ToInt32(parameters[Constants.SearchParameters.PageStart]);
                var pageSize = Convert.ToInt32(parameters[Constants.SearchParameters.PageSize]);
                var searchText = parameters[Constants.SearchParameters.SearchText]?.ToString() ?? "%";
                var sortColumn = parameters[Constants.SearchParameters.SortColumn]?.ToString() ?? "LastModifiedAt";
                var sortOrder = parameters[Constants.SearchParameters.SortOrder]?.ToString() ?? "DESC";

                var query = _context.Suppliers
                    .Where(x => x.Status == (int)StatusTypeDB.Active)
                    .AsQueryable();

                if (searchText != "%")
                {
                    query = query.Where(x => x.SupplierName.Contains(searchText) || x.ContactEmail!.Contains(searchText));
                }

                var total = await query.CountAsync();

                query = sortOrder.ToUpper() == "DESC"
                    ? query.OrderByDescending(x => EF.Property<object>(x, sortColumn))
                    : query.OrderBy(x => EF.Property<object>(x, sortColumn));

                var suppliers = await query.Skip((pageStart - 1) * pageSize).Take(pageSize)
                    .Select(s => MapToResponse(s)).ToListAsync();

                var page = new Page
                {
                    Result = suppliers
                };
                page.Meta.TotalResults = total;

                return page;
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error fetching suppliers: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        public async Task<SupplierResponseModel?> GetSupplierBySidAsync(string supplierSid)
        {
            try
            {
                var supplier = await _context.Suppliers
                    .FirstOrDefaultAsync(x => x.SupplierSid == supplierSid && x.Status == (int)StatusTypeDB.Active);

                if (supplier == null)
                    return null;

                _logger.LogInformation("Fetched supplier with SID {Sid}", supplierSid);
                return MapToResponse(supplier);
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error fetching supplier: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        public async Task<SupplierResponseModel> AddSupplierAsync(SupplierRequestModel model)
        {
            try
            {
                var entity = new Supplier
                {
                    SupplierSid = "SUP" + Guid.NewGuid().ToString("N").Substring(0, 13).ToUpper(),
                    SupplierName = model.SupplierName,
                    ContactEmail = model.ContactEmail,
                    Phone = model.Phone,
                    Address = model.Address,
                    Status = (int)StatusTypeDB.Active,
                    CreatedAt = DateTime.UtcNow
                };

                _context.Suppliers.Add(entity);
                await _context.SaveChangesAsync();

                _logger.LogInformation("Added new supplier with SID {Sid}", entity.SupplierSid);
                return MapToResponse(entity);
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error adding supplier: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        public async Task<SupplierResponseModel> UpdateSupplierAsync(string supplierSid, SupplierRequestModel model)
        {
            try
            {
                var supplier = await _context.Suppliers
                    .FirstOrDefaultAsync(x => x.SupplierSid == supplierSid && x.Status == (int)StatusTypeDB.Active);

                if (supplier == null)
                    throw new HttpStatusCodeException(404, "Supplier not found.");

                supplier.SupplierName = model.SupplierName;
                supplier.ContactEmail = model.ContactEmail;
                supplier.Phone = model.Phone;
                supplier.Address = model.Address;
                supplier.LastModifiedAt = DateTime.UtcNow;

                _context.Suppliers.Update(supplier);
                await _context.SaveChangesAsync();

                _logger.LogInformation("Updated supplier with SID {Sid}", supplierSid);
                return MapToResponse(supplier);
            }
            catch (HttpStatusCodeException)
            {
                throw;
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error updating supplier: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        public async Task DeleteSupplierAsync(string supplierSid)
        {
            try
            {
                var supplier = await _context.Suppliers
                    .FirstOrDefaultAsync(x => x.SupplierSid == supplierSid && x.Status == (int)StatusTypeDB.Active);

                if (supplier == null)
                    throw new HttpStatusCodeException(404, "Supplier not found.");

                supplier.Status = (int)StatusTypeDB.Delete;
                supplier.LastModifiedAt = DateTime.UtcNow;

                _context.Suppliers.Update(supplier);
                await _context.SaveChangesAsync();

                _logger.LogInformation("Soft deleted supplier with SID {Sid}", supplierSid);
            }
            catch (HttpStatusCodeException)
            {
                throw;
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error deleting supplier: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        private static SupplierResponseModel MapToResponse(Supplier supplier)
        {
            return new SupplierResponseModel
            {
                SupplierSid = supplier.SupplierSid,
                SupplierName = supplier.SupplierName,
                ContactEmail = supplier.ContactEmail,
                Phone = supplier.Phone,
                Address = supplier.Address,
                Status = supplier.Status,
                CreatedAt = supplier.CreatedAt,
                LastModifiedAt = supplier.LastModifiedAt
            };
        }
    }
}
