using ProductInventoryTrackerAPI.Common;
using ProductInventoryTrackerAPI.Model.CommonModel;
using ProductInventoryTrackerAPI.Model.ProductInventoryDB;
using ProductInventoryTrackerAPI.Model.RequestModel;
using ProductInventoryTrackerAPI.Model.ResponseModel;
using ProductInventoryTrackerAPI.Service.Repository.Interfaces;
using ProductInventoryTrackerAPI.Service.UnitOfWork;
using Microsoft.AspNetCore.Mvc.Rendering;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;
using static ProductInventoryTrackerAPI.Common.Enums;

namespace ProductInventoryTrackerAPI.Service.Repository.Implementation
{
    public class ProductRepository : IProductRepository
    {
        private readonly ProductInventoryDBContext _context;
        private readonly ILogger<ProductRepository> _logger;
        private readonly IUnitOfWork _unitOfWork;

        public ProductRepository(
            ProductInventoryDBContext context,
            ILogger<ProductRepository> logger,
            IUnitOfWork unitOfWork)
        {
            _context = context;
            _logger = logger;
            _unitOfWork = unitOfWork;
        }

        public async Task<Page> GetProductsAsync(Dictionary<string, object> parameters)
        {
            try
            {
                var query = _context.Products
                    .Include(x => x.Category)
                    .Include(x => x.Supplier)
                    .Where(x => x.Status == (int)StatusTypeDB.Active)
                    .AsQueryable();

                var pageStart = Convert.ToInt32(parameters[Constants.SearchParameters.PageStart]);
                var pageSize = Convert.ToInt32(parameters[Constants.SearchParameters.PageSize]);
                var searchText = parameters[Constants.SearchParameters.SearchText]?.ToString() ?? "%";
                var sortColumnInput = parameters[Constants.SearchParameters.SortColumn]?.ToString() ?? "CreatedAt";
                var sortColumn = CommonHelper.ResolvePropertyName<Product>(sortColumnInput, "CreatedAt");
                var sortOrder = parameters[Constants.SearchParameters.SortOrder]?.ToString() ?? "DESC";

                if (searchText != "%")
                {
                    query = query.Where(x => x.ProductName.Contains(searchText) || x.Sku.Contains(searchText));
                }

                var total = await query.CountAsync();

                query = sortOrder.ToUpper() == "DESC"
                    ? query.OrderByDescending(x => EF.Property<object>(x, sortColumn))
                    : query.OrderBy(x => EF.Property<object>(x, sortColumn));

                var products = await query
                    .Skip((pageStart - 1) * pageSize)
                    .Take(pageSize)
                    .Select(p => MapToResponse(p))
                    .ToListAsync();

                var page = new Page { Result = products };
                page.Meta.TotalResults = total;

                return page;
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error fetching products: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        public async Task<ProductResponseModel?> GetProductBySidAsync(string productSid)
        {
            try
            {
                var product = await _unitOfWork
                    .GetRepository<Product>()
                    .SingleOrDefaultAsync(x => x.ProductSid == productSid && x.Status == (int)StatusTypeDB.Active);

                if (product == null)
                    return null;

                await _context.Entry(product).Reference(x => x.Category).LoadAsync();
                await _context.Entry(product).Reference(x => x.Supplier).LoadAsync();

                _logger.LogInformation("Fetched product with SID {Sid}", productSid);
                return MapToResponse(product);
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error fetching product: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        public async Task<ProductResponseModel> AddProductAsync(ProductRequestModel model)
        {
            try
            {
                int? categoryId = null;
                if (!string.IsNullOrEmpty(model.CategorySid))
                {
                    var category = await _unitOfWork
                        .GetRepository<Category>()
                        .SingleOrDefaultAsync(x => x.CategorySid == model.CategorySid && x.Status == (int)StatusTypeDB.Active);

                    if (category == null)
                        throw new HttpStatusCodeException(400, "Invalid category selected.");

                    categoryId = category.CategoryId;
                }

                int? supplierId = null;
                if (!string.IsNullOrEmpty(model.SupplierSid))
                {
                    var supplier = await _unitOfWork
                        .GetRepository<Supplier>()
                        .SingleOrDefaultAsync(x => x.SupplierSid == model.SupplierSid && x.Status == (int)StatusTypeDB.Active);

                    if (supplier == null)
                        throw new HttpStatusCodeException(400, "Invalid supplier selected.");

                    supplierId = supplier.SupplierId;
                }

                var entity = new Product
                {
                    ProductSid = CommonHelper.GenerateUniqueSID(Constants.SIDPrefixes.Product),
                    ProductName = model.ProductName,
                    Sku = model.Sku,
                    Description = model.Description,
                    CategoryId = categoryId,
                    SupplierId = supplierId,
                    UnitPrice = model.UnitPrice,
                    CurrentStock = model.CurrentStock,
                    ReorderThreshold = model.ReorderThreshold,
                    Status = (int)StatusTypeDB.Active,
                    CreatedAt = DateTime.UtcNow
                };

                await _unitOfWork.GetRepository<Product>().InsertAsync(entity);
                await _unitOfWork.CommitAsync();

                // Reload with relationships
                var category_ref = await _unitOfWork.GetRepository<Category>().SingleOrDefaultAsync(x => x.CategoryId == categoryId);
                var supplier_ref = await _unitOfWork.GetRepository<Supplier>().SingleOrDefaultAsync(x => x.SupplierId == supplierId);

                entity.Category = category_ref;
                entity.Supplier = supplier_ref;

                _logger.LogInformation("Added new product with SID {Sid}", entity.ProductSid);
                return MapToResponse(entity);
            }
            catch (HttpStatusCodeException)
            {
                throw;
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error adding product: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        public async Task<ProductResponseModel> UpdateProductAsync(string productSid, ProductRequestModel model)
        {
            try
            {
                var product = await _unitOfWork
                    .GetRepository<Product>()
                    .SingleOrDefaultAsync(x => x.ProductSid == productSid && x.Status == (int)StatusTypeDB.Active);

                if (product == null)
                    return null;

                if (!string.IsNullOrEmpty(model.CategorySid))
                {
                    var category = await _unitOfWork
                        .GetRepository<Category>()
                        .SingleOrDefaultAsync(x => x.CategorySid == model.CategorySid && x.Status == (int)StatusTypeDB.Active);

                    product.CategoryId = category?.CategoryId;
                }

                if (!string.IsNullOrEmpty(model.SupplierSid))
                {
                    var supplier = await _unitOfWork
                        .GetRepository<Supplier>()
                        .SingleOrDefaultAsync(x => x.SupplierSid == model.SupplierSid && x.Status == (int)StatusTypeDB.Active);

                    product.SupplierId = supplier?.SupplierId;
                }

                product.ProductName = model.ProductName;
                product.Sku = model.Sku;
                product.Description = model.Description;
                product.UnitPrice = model.UnitPrice;
                product.CurrentStock = model.CurrentStock;
                product.ReorderThreshold = model.ReorderThreshold;
                product.LastModifiedAt = DateTime.UtcNow;

                _unitOfWork.GetRepository<Product>().Update(product);
                await _unitOfWork.CommitAsync();

                _logger.LogInformation("Updated product with SID {Sid}", productSid);
                return MapToResponse(product);
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error updating product: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        public async Task<bool> DeleteProductAsync(string productSid)
        {
            try
            {
                var product = await _unitOfWork
                    .GetRepository<Product>()
                    .SingleOrDefaultAsync(x => x.ProductSid == productSid && x.Status == (int)StatusTypeDB.Active);

                if (product == null)
                    return false;

                product.Status = (int)StatusTypeDB.Delete;
                product.LastModifiedAt = DateTime.UtcNow;

                _unitOfWork.GetRepository<Product>().Update(product);
                await _unitOfWork.CommitAsync();

                _logger.LogInformation("Soft deleted product with SID {Sid}", productSid);
                return true;
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error deleting product: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        public async Task<Page> GetLowStockProductsAsync(Dictionary<string, object> parameters)
        {
            try
            {
                var query = _context.Products
                    .Include(x => x.Category)
                    .Include(x => x.Supplier)
                    .Where(x => x.Status == (int)StatusTypeDB.Active && x.CurrentStock <= x.ReorderThreshold)
                    .AsQueryable();

                var pageStart = Convert.ToInt32(parameters[Constants.SearchParameters.PageStart]);
                var pageSize = Convert.ToInt32(parameters[Constants.SearchParameters.PageSize]);
                var sortColumn = parameters[Constants.SearchParameters.SortColumn]?.ToString() ?? "CurrentStock";
                var sortOrder = parameters[Constants.SearchParameters.SortOrder]?.ToString() ?? "ASC";

                var total = await query.CountAsync();

                query = sortOrder.ToUpper() == "DESC"
                    ? query.OrderByDescending(x => EF.Property<object>(x, sortColumn))
                    : query.OrderBy(x => EF.Property<object>(x, sortColumn));

                var products = await query
                    .Skip((pageStart - 1) * pageSize)
                    .Take(pageSize)
                    .Select(p => MapToResponse(p))
                    .ToListAsync();

                var page = new Page { Result = products };
                page.Meta.TotalResults = total;

                return page;
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error fetching low stock products: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        public async Task<IEnumerable<SelectListItem>?> DDLProductAsync(
            List<string>? filterSid = null,
            List<int>? filterId = null)
        {
            try
            {
                var data = await _unitOfWork
                    .GetRepository<Product>()
                    .GetAllAsync(x => x.Status == (int)StatusTypeDB.Active);

                if (data == null)
                    return null;

                if (filterSid != null && filterSid.Count > 0)
                    data = data.Where(x => filterSid.Contains(x.ProductSid)).ToList();

                if (filterId != null && filterId.Count > 0)
                    data = data.Where(x => filterId.Contains(x.ProductId)).ToList();

                var dropdown = data.Select(x => new SelectListItem
                {
                    Value = x.ProductSid.ToString(),
                    Text = x.ProductName
                }).OrderBy(x => x.Text);

                return dropdown;
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error fetching product dropdown: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        private static ProductResponseModel MapToResponse(Product product)
        {
            return new ProductResponseModel
            {
                ProductSid = product.ProductSid,
                ProductName = product.ProductName,
                Sku = product.Sku,
                Description = product.Description,
                CategoryName = product.Category?.CategoryName,
                SupplierName = product.Supplier?.SupplierName,
                UnitPrice = product.UnitPrice,
                CurrentStock = product.CurrentStock,
                ReorderThreshold = product.ReorderThreshold,
                Status = product.Status,
                CreatedAt = product.CreatedAt,
                LastModifiedAt = product.LastModifiedAt
            };
        }
    }
}
