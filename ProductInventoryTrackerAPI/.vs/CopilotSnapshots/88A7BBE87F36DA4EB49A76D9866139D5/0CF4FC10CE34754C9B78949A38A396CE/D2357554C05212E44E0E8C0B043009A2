using ProductInventoryTrackerAPI.Common;
using ProductInventoryTrackerAPI.Model.CommonModel;
using ProductInventoryTrackerAPI.Model.ProductInventoryDB;
using ProductInventoryTrackerAPI.Model.RequestModel;
using ProductInventoryTrackerAPI.Model.ResponseModel;
using ProductInventoryTrackerAPI.Service.Repository.Interfaces;
using ProductInventoryTrackerAPI.Service.UnitOfWork;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;
using static ProductInventoryTrackerAPI.Common.Enums;

namespace ProductInventoryTrackerAPI.Service.Repository.Implementation
{
    public class StockTransactionRepository : IStockTransactionRepository
    {
        private readonly ProductInventoryDBContext _context;
        private readonly ILogger<StockTransactionRepository> _logger;
        private readonly IUnitOfWork _unitOfWork;

        public StockTransactionRepository(
            ProductInventoryDBContext context,
            ILogger<StockTransactionRepository> logger,
            IUnitOfWork unitOfWork)
        {
            _context = context;
            _logger = logger;
            _unitOfWork = unitOfWork;
        }

        public async Task<Page> GetStockTransactionsAsync(Dictionary<string, object> parameters)
        {
            try
            {
                var query = _context.StockTransactions
                    .Include(x => x.Product)
                    .Where(x => x.Status == (int)StatusTypeDB.Active)
                    .AsQueryable();

                var pageStart = Convert.ToInt32(parameters[Constants.SearchParameters.PageStart]);
                var pageSize = Convert.ToInt32(parameters[Constants.SearchParameters.PageSize]);
                var searchText = parameters[Constants.SearchParameters.SearchText]?.ToString() ?? "%";
                var sortColumn = parameters[Constants.SearchParameters.SortColumn]?.ToString() ?? "TransactionDate";
                var sortOrder = parameters[Constants.SearchParameters.SortOrder]?.ToString() ?? "DESC";

                if (searchText != "%")
                {
                    query = query.Where(x => x.Product.ProductName.Contains(searchText) || x.TransactionType.Contains(searchText));
                }

                var total = await query.CountAsync();

                query = sortOrder.ToUpper() == "DESC"
                    ? query.OrderByDescending(x => EF.Property<object>(x, sortColumn))
                    : query.OrderBy(x => EF.Property<object>(x, sortColumn));

                var transactions = await query
                    .Skip((pageStart - 1) * pageSize)
                    .Take(pageSize)
                    .Select(st => MapToResponse(st))
                    .ToListAsync();

                var page = new Page { Result = transactions };
                page.Meta.TotalResults = total;

                return page;
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error fetching stock transactions: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        public async Task<StockTransactionResponseModel?> GetStockTransactionBySidAsync(string transactionSid)
        {
            try
            {
                var transaction = await _unitOfWork
                    .GetRepository<StockTransaction>()
                    .SingleOrDefaultAsync(x => x.StockTransactionSid == transactionSid && x.Status == (int)StatusTypeDB.Active);

                if (transaction == null)
                    return null;

                await _context.Entry(transaction).Reference(x => x.Product).LoadAsync();

                _logger.LogInformation("Fetched stock transaction with SID {Sid}", transactionSid);
                return MapToResponse(transaction);
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error fetching stock transaction: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        public async Task<StockTransactionResponseModel> AddStockTransactionAsync(StockTransactionRequestModel model)
        {
            try
            {
                var product = await _unitOfWork
                    .GetRepository<Product>()
                    .SingleOrDefaultAsync(x => x.ProductSid == model.ProductSid && x.Status == (int)StatusTypeDB.Active);

                if (product == null)
                    throw new HttpStatusCodeException(400, "Product not found.");

                if (model.TransactionType == "OUT" && product.CurrentStock < model.Quantity)
                    throw new HttpStatusCodeException(400, "Insufficient stock available.");

                var entity = new StockTransaction
                {
                    StockTransactionSid = "STX" + Guid.NewGuid().ToString("N").Substring(0, 13).ToUpper(),
                    ProductId = product.ProductId,
                    TransactionType = model.TransactionType,
                    Quantity = model.Quantity,
                    Notes = model.Notes,
                    TransactionDate = DateTime.UtcNow,
                    Status = (int)StatusTypeDB.Active,
                    CreatedAt = DateTime.UtcNow
                };

                if (model.TransactionType == "IN")
                    product.CurrentStock += model.Quantity;
                else if (model.TransactionType == "OUT")
                    product.CurrentStock -= model.Quantity;

                product.LastModifiedAt = DateTime.UtcNow;

                await _unitOfWork.GetRepository<StockTransaction>().InsertAsync(entity);
                _unitOfWork.GetRepository<Product>().Update(product);
                await _unitOfWork.CommitAsync();

                entity.Product = product;

                _logger.LogInformation("Added new stock transaction with SID {Sid}", entity.StockTransactionSid);
                return MapToResponse(entity);
            }
            catch (HttpStatusCodeException)
            {
                throw;
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error adding stock transaction: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        public async Task<Page> GetProductTransactionHistoryAsync(string productSid, Dictionary<string, object> parameters)
        {
            try
            {
                var product = await _unitOfWork
                    .GetRepository<Product>()
                    .SingleOrDefaultAsync(x => x.ProductSid == productSid && x.Status == (int)StatusTypeDB.Active);

                if (product == null)
                    throw new HttpStatusCodeException(404, "Product not found.");

                var query = _context.StockTransactions
                    .Include(x => x.Product)
                    .Where(x => x.ProductId == product.ProductId && x.Status == (int)StatusTypeDB.Active)
                    .AsQueryable();

                var pageStart = Convert.ToInt32(parameters[Constants.SearchParameters.PageStart]);
                var pageSize = Convert.ToInt32(parameters[Constants.SearchParameters.PageSize]);
                var sortColumn = parameters[Constants.SearchParameters.SortColumn]?.ToString() ?? "TransactionDate";
                var sortOrder = parameters[Constants.SearchParameters.SortOrder]?.ToString() ?? "DESC";

                var total = await query.CountAsync();

                query = sortOrder.ToUpper() == "DESC"
                    ? query.OrderByDescending(x => EF.Property<object>(x, sortColumn))
                    : query.OrderBy(x => EF.Property<object>(x, sortColumn));

                var transactions = await query
                    .Skip((pageStart - 1) * pageSize)
                    .Take(pageSize)
                    .Select(st => MapToResponse(st))
                    .ToListAsync();

                var page = new Page { Result = transactions };
                page.Meta.TotalResults = total;

                return page;
            }
            catch (Exception e)
            {
                _logger.LogError(e, "Error fetching product transaction history: {Message}", e.Message);
                throw new HttpStatusCodeException(500, e.InnerException?.Message ?? e.Message);
            }
        }

        private static StockTransactionResponseModel MapToResponse(StockTransaction transaction)
        {
            return new StockTransactionResponseModel
            {
                StockTransactionSid = transaction.StockTransactionSid,
                ProductSid = transaction.Product.ProductSid,
                ProductName = transaction.Product.ProductName,
                TransactionType = transaction.TransactionType,
                Quantity = transaction.Quantity,
                Notes = transaction.Notes,
                TransactionDate = transaction.TransactionDate,
                Status = transaction.Status,
                CreatedAt = transaction.CreatedAt,
                LastModifiedAt = transaction.LastModifiedAt
            };
        }
    }
}
